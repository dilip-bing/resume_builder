{
  "manifest_version": 3,
  "name": "Resume & Cover Letter Generator",
  "version": "1.0",
  "description": "Generate resume and cover letter from job description on any page.",
  "permissions": ["scripting", "activeTab", "storage", "downloads", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "ATS Resume Assistant"
  }
}
